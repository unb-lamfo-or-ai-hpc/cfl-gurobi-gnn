#!/bin/bash
#SBATCH --job-name=pyscipopt_node_probe
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=00:10:00
#SBATCH --output=slurm_pyscipopt_node_probe_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"
PROBE_MODE="${PROBE_MODE:-toy}"
INSTANCE_PATH="${INSTANCE_PATH:-}"
EXPERIMENT_NAME="${EXPERIMENT_NAME:-pyscipopt_node_prototype_${SLURM_JOB_ID}}"
WRITE_TRANSFORMED_CONTROLS="${WRITE_TRANSFORMED_CONTROLS:-1}"
OUTPUT_DIR="${DATA_ROOT}/analysis/pyscipopt_node_prototype/${EXPERIMENT_NAME}"

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env

if [[ "$PROBE_MODE" == "toy" ]]; then
    SOURCE_ARGS=(--toy)
elif [[ "$PROBE_MODE" == "instance" && -n "$INSTANCE_PATH" && -s "$INSTANCE_PATH" ]]; then
    SOURCE_ARGS=(--instance "$INSTANCE_PATH")
else
    echo "Set PROBE_MODE=toy or PROBE_MODE=instance with a readable INSTANCE_PATH" >&2
    exit 2
fi

python3 -c 'import pyscipopt'

CONTROL_ARGS=()
if [[ "$WRITE_TRANSFORMED_CONTROLS" == "0" ]]; then
    CONTROL_ARGS+=(--skip_transformed_controls)
fi

srun python3 -m cfl_gnn.cli.audit_pyscipopt_node_subproblems \
    "${SOURCE_ARGS[@]}" \
    "${CONTROL_ARGS[@]}" \
    --output_dir "$OUTPUT_DIR" \
    --time_limit 60 \
    --node_limit 100 \
    --max_samples 4 \
    --min_depth 1 \
    --max_depth 8 \
    --presolve off \
    --seed 42
