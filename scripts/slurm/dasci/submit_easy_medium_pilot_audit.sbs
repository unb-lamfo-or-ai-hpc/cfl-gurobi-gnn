#!/bin/bash
#SBATCH --job-name=cfl_medium_audit
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=8G
#SBATCH --time=00:20:00
#SBATCH --output=slurm_cfl_medium_audit_%j.out
set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?submit from repository root}}"
cd "$EXEC_DIR"
test -f pyproject.toml
export PYTHONPATH="${EXEC_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
srun python3 -m cfl_gnn.cli.run_easy_medium_pilot audit \
    --plan_dir "${MEDIUM_PLAN_DIR:?}" --run_root "${MEDIUM_RUN_ROOT:?}" \
    --output_dir "${MEDIUM_AUDIT_DIR:?}"
