#!/bin/bash
#SBATCH --job-name=gasse_aug_arm
#SBATCH --array=0-3
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=02:00:00
#SBATCH --output=slurm_gasse_aug_arm_%A_%a.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] submit from the repository root or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"
: "${GASSE_AUGMENTED_DATASET_DIR:?Set GASSE_AUGMENTED_DATASET_DIR}"
: "${GASSE_AUGMENTED_RUN_ROOT:?Set GASSE_AUGMENTED_RUN_ROOT}"

ARMS=(
    gurobi_original
    gurobi_incumbent_augmented
    scip_original
    scip_incumbent_augmented
)
ARM_ID="${ARMS[${SLURM_ARRAY_TASK_ID}]}"
OUTPUT_DIR="${GASSE_AUGMENTED_RUN_ROOT}/${ARM_ID}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import torch, torch_geometric'

TRAINING_PLAN="${GASSE_AUGMENTED_DATASET_DIR}/arms/${ARM_ID}/gasse_training_plan.json"

srun python3 -m cfl_gnn.cli.train_gasse_plan \
    --training_plan "${TRAINING_PLAN}" \
    --artifact_root "${GASSE_AUGMENTED_DATASET_DIR}" \
    --output_dir "${OUTPUT_DIR}" \
    --mode serial \
    --epochs "${GASSE_EPOCHS:-1}" \
    --device cuda \
    --overwrite
