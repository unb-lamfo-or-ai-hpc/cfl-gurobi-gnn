#!/bin/bash
#SBATCH --job-name=cfl_medium8h
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --time=12:00:00
#SBATCH --output=slurm_cfl_medium8h_%A_%a.out

set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?Submit from the repository root}}"
exec bash "${EXEC_DIR}/scripts/slurm/dasci/run_gurobi_expansion_campaign.sh" \
    medium "${SLURM_ARRAY_TASK_ID:?Submit one five-task array with concurrency one}"
