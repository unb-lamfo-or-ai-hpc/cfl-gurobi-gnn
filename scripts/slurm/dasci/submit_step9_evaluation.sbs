#!/bin/bash
#SBATCH --job-name=gnn_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1       # Allocate one GPU for inference
#SBATCH --time=00:30:00
#SBATCH --output=slurm_evaluation_%j.out

echo "=== Starting held-out model diagnostics (legacy route) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

# Activate the environment.
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# Evaluation configuration
# Select the checkpoint from the corresponding DDP training run.
MODELO_PATH="/home/vrcelestino/discodatos/cfl-gurobi-gnn/data/models/run_02_partial_dataset_ddp/best_model.pt"
EXPERIMENT_NAME="run_02_partial_dataset_ddp"
# --------------------------------------

echo "Evaluating checkpoint: $MODELO_PATH"
echo "Saving results to: data/analysis/$EXPERIMENT_NAME"

# Run the legacy serial evaluator with DDP checkpoint-key handling.
srun python3 -m cfl_gnn.cli.evaluate \
    --model_path $MODELO_PATH \
    --experiment_name $EXPERIMENT_NAME \
    --hidden_dim 64 \
    --batch_size 1 \
    --easy_split 4605 986 988 \
    --medium_split 214 46 47 \
    --hard_split 0 0 0

#    --easy_split 30 0 0 \
#    --medium_split 15 10 5 \
#    --hard_split 0 0 0   

echo "=== Job finished ==="

