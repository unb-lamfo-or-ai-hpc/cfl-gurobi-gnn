#!/bin/bash
#SBATCH --job-name=cfl_transformer
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=16G
#SBATCH --gres=gpu:0       # Solo lectura de texto y metadatos, no requiere GPU
#SBATCH --time=02:00:00
#SBATCH --output=slurm_transformer_%j.out

echo "=== Extrayendo metadatos crudos con transformer.py ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# Parámetros (Ajuste las rutas según donde tenga sus archivos .lp.gz)
INPUT_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn/data/raw/MILPBench/CFL/CFL_hard_instance/LP"
OUTPUT_FILE="data/analysis/raw_metadata/cfl_hard_summary.parquet"

srun python3 src/data_transformation/transformer.py \
    --input_dir $INPUT_DIR \
    --output_file $OUTPUT_FILE

echo "=== Job Finalizado ==="