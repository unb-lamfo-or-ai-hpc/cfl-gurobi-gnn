#!/bin/bash
#SBATCH --job-name=cfl_42_graph_audit
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --output=slurm_cfl_42_graph_audit_%j.out
set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?submit from repository root}}"
cd "$EXEC_DIR"
test -f pyproject.toml
export PYTHONPATH="${EXEC_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
COHORT_ARGS=()
if [[ -n "${CONFIRMATION_COHORT_REVISION_DIR:-}" ]]; then
    COHORT_ARGS=(--cohort_revision_dir "$CONFIRMATION_COHORT_REVISION_DIR")
fi
srun python3 -m cfl_gnn.cli.run_confirmation_training consolidate \
    --campaign_dir "${CONFIRMATION_EXECUTION_DIR:?}" \
    --dataset_dir "${CONFIRMATION_DATASET_DIR:?}" "${COHORT_ARGS[@]}"
