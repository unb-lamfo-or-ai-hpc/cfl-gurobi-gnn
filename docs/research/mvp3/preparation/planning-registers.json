  "sprints": [
    {
      "id": "S1",
      "title": "Scientific contract and instrumentation",
      "window": "24 November-18 December 2026",
      "packages": "S1-A contract, schemas and split; S1-B native instrumentation",
      "deliverable": "Versioned contracts, 42/9/9 parent manifest, event/clock definitions and audit/collection design",
      "acceptance": "All approved parameters, mathematical identities and accounting scopes are represented; synthetic/offline checks establish callback and missingness semantics.",
      "dependency": "Approved protocol v3",
      "next": "Release only a concrete reviewed preparation batch through the author CLI"
    },
    {
      "id": "S2",
      "title": "Root features and qualified labels",
      "window": "4-18 December 2026; 11-22 January 2027",
      "packages": "S2-A root capture; S2-B incumbent audit, graphs and dataset",
      "deliverable": "66 feature and 66 label dispositions; accepted learning dataset",
      "acceptance": "Every planned parent has a reconciled disposition. Only complete audited features and admissible incumbent labels enter the accepted dataset; incomplete coverage receives an explicit author decision before training.",
      "dependency": "Accepted S1 contracts and author release",
      "next": "Accept dataset coverage and freeze its exact identities"
    },
    {
      "id": "S3",
      "title": "Equivalent-work learning and policy freeze",
      "window": "25-29 January 2027",
      "packages": "S3-A matched serial/DDP training; S3-B validation selection and R/G policies",
      "deliverable": "Two matched-work training returns; frozen predictor and independent guidance policies",
      "acceptance": "Serial 1 V100 and DDP 4 V100 share initialisation, transformations and 4200 global updates; validation alone selects the predictor. R/G thresholds, ranking, support and ties are frozen before evaluation.",
      "dependency": "Accepted S2 dataset and author training release",
      "next": "Seal predictor, transforms and Start policies"
    },
    {
      "id": "S4",
      "title": "Paired B/R/G evaluation",
      "window": "1-19 February 2027",
      "packages": "S4-A native Start adapter and paired dispatcher; S4-B collection and qualification",
      "deliverable": "45 planned cells on 15 original parents, including explicit failed/censored dispositions",
      "acceptance": "Each parent has B/R/G under common mathematical, hardware and solver contracts; hashes, completion status, audit eligibility and target-specific follow-up reconcile to the 45-cell plan.",
      "dependency": "Frozen S3 artifacts and reviewed author evaluation release",
      "next": "Freeze qualified trajectories and metric-specific eligible cohorts"
    },
    {
      "id": "S5",
      "title": "Comparative analysis and computational economics",
      "window": "22 February-5 March 2027",
      "packages": "S5-A C2/C3 analysis and reproducible tables/figures",
      "deliverable": "Paired time factors, attainment, primal/dual effort, training quality and cost/reuse analyses",
      "acceptance": "T_B/T_G and T_R/T_G use comparable clocks and positive qualified times; censoring and denominators remain visible. Preparation and recurring costs are separated; claims trace to eligible instance-level observations.",
      "dependency": "Reconciled S4 data and training/preparation records",
      "next": "Freeze derived datasets, scripts and scoped interpretations"
    },
    {
      "id": "S6",
      "title": "Scientific synthesis and dissemination",
      "window": "8-18 March 2027",
      "packages": "S6-A article, appendices and package; S6-B final audit and release",
      "deliverable": "Coauthor-reviewed article and appendices, reproducibility package and submission materials",
      "acceptance": "All methods, figures and claims trace to approved contracts and qualified evidence. Scientific limitations, data rights and reproducibility are reviewed; merge/publication/submission receive their specific approvals.",
      "dependency": "Accepted S5 synthesis and coauthor review",
      "next": "Researcher-authorised dissemination; target submission 18 March 2027"
    }
  ],
  "hypotheses": [
    {
      "id": "H1",
      "contribution": "C2",
      "proposition": "Neural guidance can reduce time to a specified quality target relative to native baseline B on some evaluated instances.",
      "reference": "S_B/G = 1 means equal elapsed time; S_B/G > 1 favours G.",
      "evidence": "Qualified paired target times and G-only/B-only attainment counts at 10%, 5%, 1% and 0.01%.",
      "interpretation": "Conditional within the 15 selected original parents and single prescribed seed/configuration; no universal-superiority requirement.",
      "protocol": "6.2-6.3"
    },
    {
      "id": "H2",
      "contribution": "C2",
      "proposition": "Neural guidance can add computational value relative to the independent relaxation-based comparator R.",
      "reference": "S_R/G = 1 means equal elapsed time; S_R/G > 1 favours G.",
      "evidence": "Qualified R/G target times, attainment, support and Start-processing evidence under the same MILP contract.",
      "interpretation": "R is generated independently of G; this comparison examines the complete guidance procedures and does not isolate a unique causal learning effect.",
      "protocol": "2.4, 6.2-6.3"
    },
    {
      "id": "H3",
      "contribution": "C2",
      "proposition": "The relative ordering of B/R/G can vary with the gap target and with primal versus dual progress.",
      "reference": "Stable ordering across targets is a descriptive reference, not an assumed law.",
      "evidence": "Within-parent four-target trajectories, qualified incumbents, bounds, presolve/root work and search effort.",
      "interpretation": "Association-based explanation; targets are repeated views of the same run rather than independent solver replications.",
      "protocol": "5.2, 6.3"
    },
    {
      "id": "H4",
      "contribution": "C3",
      "proposition": "A solver-time benefit can be offset by preparation, while reusable artifacts can make a conditional elapsed-time saving possible.",
      "reference": "C_G(k) = C_B(k) or C_R(k) is break-even; comparator/G cost factor > 1 favours G.",
      "evidence": "Nested timing ledger, reusable preparation, recurring per-use costs and explicit reuse assumptions.",
      "interpretation": "An accounting proposition under a stated scenario; theoretical break-even is not observed deployment evidence.",
      "protocol": "6.4"
    },
    {
      "id": "H5",
      "contribution": "Learning system",
      "proposition": "Four-GPU DDP can shorten training elapsed time relative to serial training when global work is held equivalent.",
      "reference": "T_serial/T_DDP = 1 means equal elapsed time; values > 1 favour DDP.",
      "evidence": "Matched 4200-update returns, parent-level validation/predictive measures, clocks, GPU-hours and memory.",
      "interpretation": "One controlled training pair; no new non-inferiority margin, repeated training campaign or causal quality-loss assertion.",
      "protocol": "2.3, 6.5"
    }
  ],
  "design": [
    [
      "Unit",
      "One original MILPBench CFL parent",
      "Graph draws, targets and methods are nested observations, not independent instances."
    ],
    [
      "Population",
      "30 easy, 30 medium, H0/H5/H10/H15/H20/H25",
      "66 parents for characterisation."
    ],
    [
      "Learning split",
      "21E+21M train; 5E+4M validation; 4E+5M test",
      "42/9/9; exact IDs frozen deterministically in S1, not selected in this preparation PR."
    ],
    [
      "Hard transfer",
      "Six hard parents outside learning partitions",
      "Evidence concerns those selected parents; not independent population-wide generalisation."
    ],
    [
      "Root run",
      "Presolve=0; Heuristics=0; Method=-1; Threads=0",
      "Complete original-variable MIPNODE root vector with event/cut provenance; no claim of an automatically cut-free LP."
    ],
    [
      "Label run",
      "Native presolve/heuristics; MIPFocus=0; MIPGap=0.0001",
      "Audited feasible incumbent labels, separate from root features; coverage accepted before training."
    ],
    [
      "Main evaluation",
      "15 parents x B/R/G = 45 fresh calls",
      "Seed42; ConcurrentMIP=1; Method=-1; Threads=0; no additional concurrent-MIP/seed/thread arms."
    ],
    [
      "Pairing",
      "Same mathematical model and hardware class within parent",
      "Predeclared rotating method order; no overlapping calls for the same parent."
    ],
    [
      "R/G treatment",
      "R independent root rounding/ranking; G frozen neural probabilities",
      "Value/probability tails <=0.1 or >=0.9; cap 10% of binaries; other Starts undefined."
    ],
    [
      "Quality targets",
      "0.10; 0.05; 0.01; 0.0001",
      "Four target observations from one trajectory; numeric factors require common attainment and positive times."
    ],
    [
      "Training",
      "1 versus 4 V100; 100 epochs; global batch4",
      "168 graph presentations and 42 updates per epoch; 4200 updates per arm."
    ],
    [
      "Analysis",
      "Per-parent paired factors, attainment, quality, effort and cost/reuse",
      "Separate easy/medium test and hard-transfer summaries; descriptive finite-cohort interpretation."
    ],
    [
      "Conditional work",
      "Up to six diagnosed-hard feasibility runs; Benders only after specific design/approval",
      "Not part of 177 primary calls; no automatic extension, exclusion, retry or replacement."
    ],
    [
      "Release",
      "At most two jobs and two Gurobi sessions; exact source/input/resource contracts",
      "All HPC execution uses the author CLI; this preparation opens no scientific run."
    ]
  ],
