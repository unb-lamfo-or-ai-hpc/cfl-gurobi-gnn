#!/bin/bash
#SBATCH --job-name=toy_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1  # Allocate one GPU for the toy experiment
#SBATCH --time=02:00:00
#SBATCH --output=slurm_toy_gnn_%j.out

echo "=== Starting the toy GNN experiment ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

# Activate the environment.
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# Run the preserved toy experiment.
srun python sandbox/toy_bipartite.py

echo "=== Job finished ==="

