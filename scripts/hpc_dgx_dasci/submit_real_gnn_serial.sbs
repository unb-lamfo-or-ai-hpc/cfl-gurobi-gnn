#!/bin/bash
#SBATCH --job-name=real_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=04:00:00
#SBATCH --output=slurm_real_gnn_%j.out

echo "=== Entrenamiento GNN con Dataset Real (Neural Diving) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd $EXEC_DIR

eval "$(conda shell.bash hook)"
conda activate tfm_env 

SCRIPT_NAME="src/gnn/train_neural_diving_serial_v3.py"

# Opción A: El escenario ideal (Rápido y Máxima Inteligencia):

## Ejemplo A: Entrenamiento Equilibrado Clásico
srun python $SCRIPT_NAME \
    --easy_split 30 0 0 \
    --medium_split 15 13 2 \
    --hard_split 0 0 5 \
    --hidden_dim 32 --lr 0.0001 --grad_clip 1.0

## Ejemplo B: El Reto OOD (Out-of-Distribution)
#srun python $SCRIPT_NAME \
#    --easy_split 30 0 0 \
#    --medium_split 0 10 0 \
#    --hard_split 0 0 10 \
#    --hidden_dim 32 --lr 0.0001 --grad_clip 1.0

## Opción B: Si la Opción A falla por OOM (Modo Supervivencia Extrema)
#srun python $SCRIPT_NAME \
#    --easy_split 30 0 0 \
#    --medium_split 0 10 0 \
#    --hard_split 0 0 10 \
#    --hidden_dim 32 --lr 0.0001 --grad_clip 1.0 --clear_cache

echo "=== Job Finalizado ==="