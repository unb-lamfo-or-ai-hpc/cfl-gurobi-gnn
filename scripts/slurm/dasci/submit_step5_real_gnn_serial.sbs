#!/bin/bash
#SBATCH --job-name=real_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=16:00:00
#SBATCH --output=slurm_real_gnn_%j.out

echo "=== Entrenamiento GNN con Dataset Real (Neural Diving) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd $EXEC_DIR

eval "$(conda shell.bash hook)"
conda activate tfm_env 

SCRIPT_NAME="src/gnn/train_neural_diving_serial_v5.py"

# Opción A: Teste
#srun python $SCRIPT_NAME \
#    --easy_split 30 0 0 \
#    --medium_split 15 10 5 \
#    --hard_split 0 0 0 \
#    --hidden_dim 64 --lr 0.00005 --grad_clip 1.0

# Opción B: Escenario con full EASY y MEDIUM parcial
srun python $SCRIPT_NAME \
    --experiment_name run_02_partial_dataset \
    --easy_split 4605 986 988 \
    --medium_split 214 46 47 \
    --hard_split 0 0 0 \
    --hidden_dim 64 \
    --lr 0.00005 \
    --grad_clip 1.0 \
    --epochs 150 \
    --patience 20 \
    --clear_cache

echo "=== Job Finalizado ==="