#!/bin/bash
#SBATCH --job-name=mvp_derived_graphs
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --time=00:45:00
#SBATCH --output=slurm_mvp_derived_graphs_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"

: "${GUROBI_CANDIDATE_DIR:?Set the passing Gurobi PR 25 candidate directory}"
: "${GUROBI_SOLVE_DIR:?Set the passing Gurobi PR 27 solve directory}"
: "${SCIP_CANDIDATE_DIR:?Set the passing SCIP PR 25 candidate directory}"
: "${SCIP_SOLVE_DIR:?Set the passing SCIP PR 27 solve directory}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-mvp_derived_graphs_${SLURM_JOB_ID}}"
OUTPUT_DIR="${DATA_ROOT}/bipartite_graphs/mvp/${EXPERIMENT_NAME}"
CONFIG="${CONFIG:-${EXEC_DIR}/configs/experiments/mvp_partial_v1.json}"
PARENT_MANIFEST="${PARENT_MANIFEST:-${EXEC_DIR}/configs/splits/cfl_90_seed42_folds.csv}"

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env
python3 -c 'import numpy, pyscipopt, torch, torch_geometric'

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.build_mvp_derived_graphs \
    --source gurobi "$GUROBI_CANDIDATE_DIR" "$GUROBI_SOLVE_DIR" \
    --source scip "$SCIP_CANDIDATE_DIR" "$SCIP_SOLVE_DIR" \
    --output_dir "$OUTPUT_DIR" \
    --config "$CONFIG" \
    --parent_manifest "$PARENT_MANIFEST" \
    "${OVERWRITE_ARGS[@]}"
