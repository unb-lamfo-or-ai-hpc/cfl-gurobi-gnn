#!/bin/bash
#SBATCH --job-name=real_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=16:00:00
#SBATCH --output=slurm_real_gnn_%j.out

echo "=== Legacy GNN training with a real dataset ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env 

MODULE_NAME="cfl_gnn.cli.train_serial"

# Option A: Small diagnostic configuration
#srun python -m $MODULE_NAME \
#    --easy_split 30 0 0 \
#    --medium_split 15 10 5 \
#    --hard_split 0 0 0 \
#    --hidden_dim 64 --lr 0.00005 --grad_clip 1.0

# Option B: Full easy and partial medium legacy graph inventory
srun python -m $MODULE_NAME \
    --experiment_name run_02_partial_dataset \
    --easy_split 4605 986 988 \
    --medium_split 214 46 47 \
    --hard_split 0 0 0 \
    --hidden_dim 64 \
    --lr 0.00005 \
    --grad_clip 1.0 \
    --epochs 150 \
    --patience 20 \
    --clear_cache

echo "=== Job finished ==="

