#!/bin/bash
#SBATCH --job-name=gnn_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1       # Utilizamos 1 GPU para que la inferencia sea instantánea
#SBATCH --time=00:30:00
#SBATCH --output=slurm_step3_evaluation_%j.out

echo "=== Iniciando Paso 3: Evaluación Académica (GPU Node) ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# --- PANEL DE CONTROL DE EVALUACIÓN ---
# Cambie esto para evaluar diferentes modelos sin sobrescribir resultados
MODELO_PATH="data/real_train_output/neural_diving_best_serial.pt"
EXPERIMENT_NAME="modelo_serial"
#MODELO_PATH="data/real_train_output/neural_diving_best_paralelo.pt"
#EXPERIMENT_NAME="modelo_paralelo"
# --------------------------------------

echo "Evaluando modelo: $MODELO_PATH"
echo "Guardando resultados en: data/analysis/$EXPERIMENT_NAME"

# Ejecutamos con los mismos splits del último entrenamiento (Test > 0)
srun python3 src/gnn/evaluate_model_v2.py \
    --model_path $MODELO_PATH \
    --experiment_name $EXPERIMENT_NAME \
    --easy_split 30 0 0 \
    --medium_split 15 13 2 \
    --hard_split 0 0 5 \
#    --easy_split 500 0 0 \
#    --medium_split 400 100 0 \
#    --hard_split 150 125 225

echo "=== Job Finalizado ==="