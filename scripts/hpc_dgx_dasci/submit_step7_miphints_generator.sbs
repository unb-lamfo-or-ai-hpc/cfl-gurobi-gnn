#!/bin/bash
#SBATCH --job-name=gnn_mipstart
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:0       # Inferencia en CPU para simular HPC
#SBATCH --time=01:00:00
#SBATCH --output=slurm_miphints_generation_%j.out

echo "=== Generando Warm-Start (.mst) en CPU ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd $EXEC_DIR

eval "$(conda shell.bash hook)"
conda activate tfm_env 

# Parámetros (Ajuste el LP_FILE a la instancia que desee acelerar)
LP_FILE="data/raw/MILPBench/CFL/CFL_hard_instance/LP/CFL_hard_instance_10.lp.gz"
MODEL_PATH="data/real_train_output/neural_diving_best_serial.pt"
CONFIDENCE=0.90

srun python3 src/gurobi_solver/generate_mip_hints.py \
    --lp_file $LP_FILE \
    --model_path $MODEL_PATH \
    --confidence $CONFIDENCE

echo "=== Job Finalizado ==="