#!/bin/bash
#SBATCH --job-name=cfl_42_train
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --output=slurm_cfl_42_train_%j.out
set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?submit from repository root}}"
cd "$EXEC_DIR"
test -f pyproject.toml
export PYTHONPATH="${EXEC_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
COHORT_ARGS=()
if [[ -n "${CONFIRMATION_COHORT_REVISION_DIR:-}" ]]; then
    COHORT_ARGS=(--cohort_revision_dir "$CONFIRMATION_COHORT_REVISION_DIR")
fi
srun python3 -m cfl_gnn.cli.run_confirmation_training train \
    --campaign_dir "${CONFIRMATION_EXECUTION_DIR:?}" \
    --dataset_dir "${CONFIRMATION_DATASET_DIR:?}" \
    --output_dir "${CONFIRMATION_TRAINING_DIR:?}" --device cuda "${COHORT_ARGS[@]}"
