*.sbs text eol=lf
*.sh text eol=lf


# Preserve byte-stable manuscript sources across Windows and Linux checkouts.
manuscript/** text eol=lf
# Evidence CSV hashes bind their original bytes, including record terminators.
manuscript/results/*.csv -text
# Current publication receipts bind exact bytes for every imported asset.
manuscript/results/current/** -text -whitespace
manuscript/elsarticle.cls -text -whitespace
manuscript/elsarticle-harv.bst -text -whitespace
.gitattributes text eol=lf
scripts/manuscript/** text eol=lf
tests/manuscript/** text eol=lf
.github/workflows/manuscript.yml text eol=lf
# Public evidence manifests bind exact bytes on Windows and Linux.
docs/evidence/mvp1/*.json -text
docs/evidence/mvp1/SHA256SUMS.txt text eol=lf
scripts/evidence/** text eol=lf
tests/evidence/** text eol=lf
configs/quality/pr64-ruff.toml text eol=lf
.github/workflows/evidence.yml text eol=lf
scripts/slurm/dasci/*pr65* text eol=lf
