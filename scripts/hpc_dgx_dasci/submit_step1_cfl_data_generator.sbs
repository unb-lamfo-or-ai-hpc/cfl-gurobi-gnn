#!/bin/bash
#SBATCH --job-name=gnn_milp_data
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8 # reduced from 30 to save memory
#SBATCH --mem=128G        # expanded from 64G to accommodate larger datasets
#SBATCH --gres=gpu:0
#SBATCH --time=08:00:00
#SBATCH --output=slurm_cfl_data_%j.out

echo "=== Inicializando Construcción de Dataset GNN (V2 DGX) ==="
EXEC_DIR="/raid/vrcelestino/data"
cd $EXEC_DIR

# Carga de credenciales de Gurobi
export GRB_LICENSE_FILE="${EXEC_DIR}/gurobi.lic"
export WLSACCESSID=$(grep WLSACCESSID $GRB_LICENSE_FILE | cut -d '=' -f 2)
export WLSSECRET=$(grep WLSSECRET $GRB_LICENSE_FILE | cut -d '=' -f 2)
export LICENSEID=$(grep LICENSEID $GRB_LICENSE_FILE | cut -d '=' -f 2 | tr -d '"')

eval "$(conda shell.bash hook)"
conda activate tfm_env 

echo "=== Ejecutando Extracción Avanzada de Gurobi ==="

CATEGORIA="CFL_easy_instance"
INICIO=0
FIN=30
TIEMPO_GUROBI=3600

echo "Lanzando lote controlado para: ${CATEGORIA} del índice ${INICIO} al ${FIN}"

# Ejecución en una sola línea (A prueba de fallos)
srun python3 cfl-gurobi-gnn/src/data_transformation/cfl_gnn_data_generator_v7.py --categories $CATEGORIA --start_idx $INICIO --end_idx $FIN --time_limit $TIEMPO_GUROBI

echo "=== Job Finalizado ==="