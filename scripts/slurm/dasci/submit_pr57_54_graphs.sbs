#!/bin/bash
#SBATCH --job-name=cfl_pr57_graph
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --time=00:40:00

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?submit from repository root}}"
cd "$EXEC_DIR"

test -f pyproject.toml

export PYTHONPATH="${EXEC_DIR}/src${PYTHONPATH:+:${PYTHONPATH}}"

export GRB_LICENSE_FILE="${GRB_LICENSE_FILE:-/home/vrcelestino/discodatos/gurobi.lic}"
test -s "$GRB_LICENSE_FILE"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

DATA_ROOT="${DATA_ROOT:?DATA_ROOT is required}"
EVIDENCE_PACKAGE="${EVIDENCE_PACKAGE:?EVIDENCE_PACKAGE is required}"
OLD_GRAPH_ROOT="${OLD_GRAPH_ROOT:?OLD_GRAPH_ROOT is required}"
PR57_DATASET_DIR="${PR57_DATASET_DIR:?PR57_DATASET_DIR is required}"

printf '[INFO] commit=%s\n' "$(git rev-parse HEAD)"
printf '[INFO] task_index=%s\n' "${SLURM_ARRAY_TASK_ID:?}"
printf '[INFO] objective=MINIMIZE seed=42 threads=1 presolve=0\n'
printf '[INFO] data_root=%s\n' "$DATA_ROOT"
printf '[INFO] dataset_dir=%s\n' "$PR57_DATASET_DIR"

srun python3 -m cfl_gnn.cli.run_pr57_training graph \
    --data_root "$DATA_ROOT" \
    --evidence_package "$EVIDENCE_PACKAGE" \
    --old_graph_root "$OLD_GRAPH_ROOT" \
    --dataset_dir "$PR57_DATASET_DIR" \
    --task_index "${SLURM_ARRAY_TASK_ID}"
