#!/bin/bash
#SBATCH --job-name=cfl_4arm_train
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=96G
#SBATCH --gres=gpu:1
#SBATCH --time=24:00:00
#SBATCH --output=slurm_scalable_four_arm_training_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from it or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${MVP_DATASET_DIR:?Set MVP_DATASET_DIR}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import numpy, torch, torch_geometric'

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.train_mvp_four_arm \
    --dataset_dir "${MVP_DATASET_DIR}" \
    --output_dir "${OUTPUT_DIR}" \
    --training_protocol configs/training/scalable_four_arm_training_v1.json \
    --device cuda \
    --clear_cache \
    "${OVERWRITE_ARGS[@]}"
