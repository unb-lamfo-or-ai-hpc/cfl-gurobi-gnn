#!/bin/bash
#SBATCH --job-name=mvp_4arm_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=01:00:00
#SBATCH --output=slurm_mvp_four_arm_evaluation_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from it or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${MVP_DATASET_DIR:?Set MVP_DATASET_DIR}"
: "${TRAINING_RUN_DIR:?Set TRAINING_RUN_DIR}"
: "${BASE_SOURCE_DIR:?Set BASE_SOURCE_DIR}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import pyscipopt, torch, torch_geometric'

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.evaluate_mvp_four_arm \
    --dataset_dir "${MVP_DATASET_DIR}" \
    --training_run_dir "${TRAINING_RUN_DIR}" \
    --base_source_dir "${BASE_SOURCE_DIR}" \
    --output_dir "${OUTPUT_DIR}" \
    --device cuda \
    --clear_cache \
    "${OVERWRITE_ARGS[@]}"
