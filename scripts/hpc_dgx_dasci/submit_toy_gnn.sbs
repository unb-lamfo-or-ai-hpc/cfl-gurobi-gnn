#!/bin/bash
#SBATCH --job-name=toy_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1  # Solicitamos 1 GPU para el entrenamiento
#SBATCH --time=02:00:00
#SBATCH --output=slurm_toy_gnn_%j.out

echo "=== Iniciando Entrenamiento GNN (Toy Sandbox) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar el entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# Ejecutar el sandbox
srun python sandbox/toy_bipartite.py

echo "=== Job Finalizado ==="