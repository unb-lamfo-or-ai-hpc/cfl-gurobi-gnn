{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cfl-gnn:mvp3:s1a:v1:evidence",
  "title": "MVP3 observation contracts (S1-A); not execution authority",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "missing_reason"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "missing_reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "properties": {
        "parent_id": {
          "type": "string",
          "pattern": "^CFL_(easy|medium|hard)_instance_[0-9]+$"
        },
        "stage": {
          "enum": [
            "root_relaxation",
            "incumbent",
            "evaluation"
          ]
        },
        "method": {
          "enum": [
            null,
            "B",
            "R",
            "G"
          ]
        },
        "seed": {
          "const": 42
        },
        "attempt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      },
      "required": [
        "parent_id",
        "stage",
        "method",
        "seed",
        "attempt"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "native_runtime",
            "worker_elapsed",
            "end_to_end",
            "reuse_elapsed"
          ]
        },
        "origin": {
          "enum": [
            "optimize_entry",
            "worker_entry",
            "pipeline_entry",
            "scenario_entry"
          ]
        },
        "unit": {
          "const": "seconds"
        }
      },
      "required": [
        "name",
        "origin",
        "unit"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vector_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "qualified",
            "unqualified"
          ]
        },
        "row_max_violation": {
          "$ref": "#/$defs/quantity"
        },
        "bound_max_violation": {
          "$ref": "#/$defs/quantity"
        },
        "integrality_max_violation": {
          "$ref": "#/$defs/quantity"
        },
        "objective_residual": {
          "$ref": "#/$defs/quantity"
        },
        "tolerances": {
          "type": "object",
          "properties": {
            "row": {
              "type": "number",
              "minimum": 0
            },
            "bound": {
              "type": "number",
              "minimum": 0
            },
            "integrality": {
              "type": "number",
              "minimum": 0
            },
            "objective": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "row",
            "bound",
            "integrality",
            "objective"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "model_sha256",
        "vector_sha256",
        "status",
        "row_max_violation",
        "bound_max_violation",
        "integrality_max_violation",
        "objective_residual",
        "tolerances"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "node_class": {
          "enum": [
            "intel-256",
            "intel-512"
          ]
        },
        "tasks": {
          "const": 1
        },
        "logical_CPUs": {
          "const": 64
        },
        "physical_cores": {
          "const": 32
        },
        "memory_GiB": {
          "enum": [
            192,
            384
          ]
        },
        "exclusive": {
          "const": true
        },
        "requested_GPUs": {
          "const": 0
        },
        "job_limit_seconds": {
          "const": 43200
        }
      },
      "required": [
        "node_class",
        "tasks",
        "logical_CPUs",
        "physical_cores",
        "memory_GiB",
        "exclusive",
        "requested_GPUs",
        "job_limit_seconds"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "elapsed": {
          "$ref": "#/$defs/quantity"
        }
      },
      "required": [
        "clock",
        "elapsed"
      ],
      "additionalProperties": false
    },
    "root_event": {
      "type": "object",
      "properties": {
        "where": {
          "const": "MIPNODE"
        },
        "status": {
          "const": "OPTIMAL"
        },
        "node_count": {
          "const": 0
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "cut_state": {
          "enum": [
            "pre_cut",
            "later_cut_pass"
          ]
        },
        "cut_pass": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "where",
        "status",
        "node_count",
        "ordinal",
        "cut_state",
        "cut_pass"
      ],
      "additionalProperties": false
    },
    "model_identity": {
      "type": "object",
      "properties": {
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variable_order_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "declared_sense": {
          "enum": [
            "MINIMIZE",
            "MAXIMIZE"
          ]
        },
        "effective_sense": {
          "const": "MINIMIZE"
        },
        "variables": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "nonzeros": {
          "type": "integer",
          "minimum": 0
        },
        "objective_constant": {
          "type": "number"
        }
      },
      "required": [
        "model_sha256",
        "variable_order_sha256",
        "declared_sense",
        "effective_sense",
        "variables",
        "rows",
        "nonzeros",
        "objective_constant"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "run"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/sha1"
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audit_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "solver_version": {
          "const": "14.0.0"
        },
        "native_defaults_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_defaults_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_defaults": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "effective_parameters": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          }
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "mathematical_identity": {
          "$ref": "#/$defs/model_identity"
        },
        "native_status": {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "missing_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "value",
            "missing_reason"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "enum": [
            "completed",
            "feature_captured",
            "time_limit",
            "memory_termination",
            "numeric_failure",
            "callback_failure",
            "infrastructure_interruption",
            "no_incumbent",
            "feature_unavailable"
          ]
        },
        "native_Work": {
          "$ref": "#/$defs/quantity"
        },
        "timings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timing"
          },
          "minItems": 1
        },
        "final": {
          "type": "object",
          "properties": {
            "primal": {
              "$ref": "#/$defs/quantity"
            },
            "dual": {
              "$ref": "#/$defs/quantity"
            },
            "gap": {
              "$ref": "#/$defs/quantity"
            },
            "vector_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vector_missing_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "audit": {
              "anyOf": [
                {
                  "$ref": "#/$defs/audit"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "primal",
            "dual",
            "gap",
            "vector_sha256",
            "vector_missing_reason",
            "audit"
          ],
          "additionalProperties": false
        },
        "supervision": {
          "type": "object",
          "properties": {
            "native_thread_count": {
              "$ref": "#/$defs/quantity"
            },
            "affinity_logical_count": {
              "$ref": "#/$defs/quantity"
            },
            "peak_process_bytes": {
              "$ref": "#/$defs/quantity"
            },
            "peak_job_bytes": {
              "$ref": "#/$defs/quantity"
            },
            "native_thread_lines_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "affinity_mapping_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "scheduler_record_sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "termination_cause": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "native_thread_count",
            "affinity_logical_count",
            "peak_process_bytes",
            "peak_job_bytes",
            "native_thread_lines_sha256",
            "affinity_mapping_sha256",
            "scheduler_record_sha256",
            "termination_cause"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "source_commit",
        "environment_sha256",
        "audit_policy_sha256",
        "input_sha256",
        "solver_version",
        "native_defaults_sha256",
        "native_defaults_receipt_sha256",
        "native_defaults",
        "effective_parameters",
        "resources",
        "mathematical_identity",
        "native_status",
        "outcome",
        "native_Work",
        "timings",
        "final",
        "supervision"
      ],
      "additionalProperties": false
    },
    "root": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "root"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variable_order_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vector_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variable_count": {
          "type": "integer",
          "minimum": 1
        },
        "captured_count": {
          "type": "integer",
          "minimum": 1
        },
        "event": {
          "$ref": "#/$defs/root_event"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "variable_order_sha256",
        "vector_sha256",
        "variable_count",
        "captured_count",
        "event",
        "audit"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "label"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variable_order_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vector_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "origin": {
          "enum": [
            "DIRECT",
            "BENDERS"
          ]
        },
        "conditional_release_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "equivalence_audit_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "tier": {
          "enum": [
            "terminal_target",
            "intermediate"
          ]
        },
        "parent_role": {
          "enum": [
            "train",
            "validation",
            "test",
            "transfer_only"
          ]
        },
        "admissible_primary_label": {
          "type": "boolean"
        },
        "audit": {
          "$ref": "#/$defs/audit"
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "variable_order_sha256",
        "vector_sha256",
        "origin",
        "conditional_release_sha256",
        "equivalence_audit_sha256",
        "gap",
        "tier",
        "parent_role",
        "admissible_primary_label",
        "audit"
      ],
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "start"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variable_order_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "original_variable_count": {
          "type": "integer",
          "minimum": 1
        },
        "binary_count": {
          "type": "integer",
          "minimum": 0
        },
        "root_artifact_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "predictor_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozen_policy_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "support": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 0
              },
              "variable_name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "enum": [
                  0,
                  1
                ]
              },
              "lower_bound": {
                "type": "number"
              },
              "upper_bound": {
                "type": "number"
              }
            },
            "required": [
              "position",
              "variable_name",
              "value",
              "lower_bound",
              "upper_bound"
            ],
            "additionalProperties": false
          }
        },
        "support_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ones_count": {
          "type": "integer",
          "minimum": 0
        },
        "unselected_coordinates": {
          "const": "UNDEFINED"
        },
        "original_model_preserved": {
          "const": true
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "variable_order_sha256",
        "original_variable_count",
        "binary_count",
        "root_artifact_sha256",
        "predictor_sha256",
        "frozen_policy_sha256",
        "support",
        "support_sha256",
        "ones_count",
        "unselected_coordinates",
        "original_model_preserved"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "event"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "where": {
          "enum": [
            "MIP",
            "MIPSOL",
            "MIPNODE"
          ]
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "primal": {
          "$ref": "#/$defs/quantity"
        },
        "dual": {
          "$ref": "#/$defs/quantity"
        },
        "gap": {
          "$ref": "#/$defs/quantity"
        },
        "nodes": {
          "$ref": "#/$defs/quantity"
        },
        "native_Work": {
          "$ref": "#/$defs/quantity"
        },
        "candidate_vector_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/audit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "event_ordinal",
        "where",
        "clock",
        "elapsed_seconds",
        "primal",
        "dual",
        "gap",
        "nodes",
        "native_Work",
        "candidate_vector_sha256",
        "candidate_audit"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "target"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "gap_target": {
          "enum": [
            0.1,
            0.05,
            0.01,
            0.0001
          ]
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "pairing_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "outcome": {
          "enum": [
            "attained",
            "right_censored",
            "numeric_ineligible",
            "memory_termination",
            "callback_failure",
            "infrastructure_interruption",
            "no_incumbent"
          ]
        },
        "attainment_seconds": {
          "$ref": "#/$defs/quantity"
        },
        "followup_seconds": {
          "type": "number",
          "minimum": 0
        },
        "observed_gap": {
          "$ref": "#/$defs/quantity"
        },
        "source_event_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_vector_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/audit"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schema_version",
        "key",
        "run_sha256",
        "model_sha256",
        "gap_target",
        "clock",
        "pairing_sha256",
        "outcome",
        "attainment_seconds",
        "followup_seconds",
        "observed_gap",
        "source_event_sha256",
        "candidate_vector_sha256",
        "candidate_audit"
      ],
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "disposition"
        },
        "schema_version": {
          "const": "mvp3-s1a-v1"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "run_sha256": {
          "$ref": "#/$defs/sha256"
