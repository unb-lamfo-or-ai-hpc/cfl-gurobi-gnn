{
  "schema_version": "mvp3-proposal-v1",
  "status": "specification_not_implemented",
  "unit": "original_instance",
  "tables": {
    "instances": {
      "primary_key": "instance_id",
      "fields": {
        "instance_id": "original MILPBench parent ID",
        "display_alias": "E/M/H alias",
        "difficulty": "easy|medium|hard",
        "source_file_sha256": "64hex",
        "decoded_model_sha256": "64hex when compressed",
        "mathematical_signature_sha256": "64hex",
        "original_objective_sense": "as distributed",
        "effective_objective_sense": "MINIMIZE",
        "num_variables": "integer",
        "num_binary": "integer",
        "num_integer": "integer",
        "num_continuous": "integer",
        "num_constraints": "integer",
        "num_nonzeros": "integer",
        "graph_variable_nodes": "integer|null with reason",
        "graph_constraint_nodes": "integer|null with reason",
        "graph_edges": "integer|null with reason",
        "historical_exposure": "enumerated provenance",
        "learning_role": "train|validation|test|transfer_only|not_admitted",
        "admission_status": "qualified|missing|numeric_ineligible|decision_required"
      }
    },
    "executions": {
      "primary_key": "execution_id",
      "foreign_key": "instance_id",
      "fields": {
        "method": "B|R|G|Benders_separate_future",
        "phase": "characterization|paired_evaluation|preparation|technical_qualification",
        "solver_version": "exact tuple/build",
        "source_commit": "40hex",
        "parameter_map": "all effective algorithmic parameters",
        "parameter_sha256": "canonical binding",
        "environment": "Python, gurobipy, OS, license fingerprint without secrets",
        "input_artifact_hashes": "model/root/graph/checkpoint/prediction/Start as applicable",
        "resources": "physical cores, logical CPUs, sibling map, cpuset, NUMA, Slurm limits",
        "observed_resources": "CPU deltas, native thread ceiling/count, process/cgroup/native memory with units/scope",
        "native_runtime_seconds": "finite nonnegative",
        "native_work": "finite nonnegative|null with reason",
        "node_count": "finite nonnegative",
        "incumbent_available": "boolean",
        "reported_objective": "number|null",
        "recalculated_objective": "number|null",
        "reported_dual_bound": "number|null",
        "reported_gap": "number|null",
        "terminal_status": "native code and normalized reason",
        "independent_audit": "residuals, tolerances, integrality, objective and scope",
        "start_processing": "submitted|observed_processing|observed_acceptance|unobserved|not_applicable",
        "timing_regions": "native/build/preparation/transfer/inference/audit/export with explicit nesting",
        "job_ids": "Slurm parent/step/array identifiers",
        "result_sha256": "immutable raw result binding"
      }
    },
    "targets": {
      "primary_key": [
        "execution_id",
        "gap_target"
      ],
      "allowed_gap_targets": [
        0.1,
        0.05,
        0.01,
        0.0001
      ],
      "fields": {
        "status": "attained|right_censored|unavailable|numeric_ineligible",
        "first_observed_seconds": "number|null",
        "first_observed_work": "number|null",
        "primal": "number|null",
        "dual": "number|null",
        "observed_gap": "number|null",
        "nodes": "number|null",
        "event_id": "reference to observation or terminal fallback",
        "clock_origin": "native solve start",
        "numeric_eligibility": "per-metric decision with reason",
        "censoring_time": "actual terminal observation, never synthetic attainment"
      }
    },
    "events": {
      "primary_key": "event_id",
      "foreign_key": "execution_id",
      "fields": {
        "where": "actual callback/log/OS event",
        "what": "queried API fields",
        "origin": "native_attribute|callback|log|OS_sample|unavailable",
        "runtime_seconds": "number|null",
        "work": "number|null",
        "candidate_objective": "number|null",
        "best_incumbent": "number|null",
        "best_dual_bound": "number|null",
        "nodes": "number|null",
        "incumbent_vector_sha256": "optional durable retained vector",
        "availability_reason": "explicit for missing values"
      }
    },
    "labels": {
      "primary_key": "label_reference_id",
      "foreign_key": "instance_id",
      "fields": {
        "originating_execution": "qualified incumbent execution ID",
        "vector_sha256": "immutable complete vector",
        "model_and_variable_order_sha256": "identity binding",
        "incumbent_gap": "reported and qualified value",
        "feasibility_integrality": "independent residual/tolerance report",
        "admission_policy_id": "precommitted label policy",
        "binary_mask_sha256": "domain mask binding",
        "root_feature_sha256": "separate inference feature binding",
        "normalization_fit_role": "training_only",
        "selection_role": "training|validation|test|excluded"
      }
    }
  },
  "invariants": [
    "no invented threshold time or Work",
    "no rounding/repaired vector promotion without a new qualified record",
    "original instance is the experimental unit",
    "no test/hard label access for training selection",
    "no field silently retrofitted into historical receipts",
    "new execution requires separate authorized protocol/source/budget",
    "M4/M12 restrictions remain per-metric",
    "allocation is not active utilization",
    "time ratios preserve explicitly declared orientation"
  ]
}
