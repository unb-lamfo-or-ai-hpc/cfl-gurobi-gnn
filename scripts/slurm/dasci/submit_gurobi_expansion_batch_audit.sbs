#!/bin/bash
#SBATCH --job-name=cfl_batch_audit
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --output=slurm_cfl_batch_audit_%j.out

set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?Submit from the repository root}}"
exec bash "${EXEC_DIR}/scripts/slurm/dasci/run_gurobi_expansion_campaign.sh" \
    audit "${MEDIUM_BATCH:?Set MEDIUM_BATCH to zero through three}"
