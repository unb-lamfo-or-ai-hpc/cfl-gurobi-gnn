#!/bin/bash
#SBATCH --job-name=audit_phase1
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:0
#SBATCH --time=00:30:00
#SBATCH --output=slurm_audit_data_gen_%j.out

echo "=== Initializing Phase 1 EDA Audit ==="

# Initialize conda and activate your specific environment
eval "$(conda shell.bash hook)"
conda activate tfm_env

# Navigate to the project working directory
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

echo "=== Running Audit Script ==="
# Execute the script
srun python3 -m cfl_gnn.cli.audit_collection --instance CFL_easy_instance_0

echo "---------------------------------------------------"
echo "=== Job Completed ==="
