#!/bin/bash
#SBATCH --job-name=mvp_parent_audit
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:10:00
#SBATCH --output=slurm_mvp_parent_audit_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from the repository root or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${VERTICAL_SLICE_DIR:?Set VERTICAL_SLICE_DIR}"
: "${PARENT_RUN_ROOT:?Set PARENT_RUN_ROOT}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.audit_mvp_vertical_slice_parents \
    --plan_dir "${VERTICAL_SLICE_DIR}" \
    --run_root "${PARENT_RUN_ROOT}" \
    "${OVERWRITE_ARGS[@]}"
