#!/bin/bash
#SBATCH --job-name=mvp_dataset
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --time=00:45:00
#SBATCH --output=slurm_mvp_dataset_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"

: "${PARENT_RUNS_FILE:?Set a TSV file with solver and parent-run directory}"
: "${DERIVED_GRAPH_DIR:?Set the passing PR 28 graph directory}"

EXPERIMENT_NAME="${EXPERIMENT_NAME:-mvp_dataset_${SLURM_JOB_ID}}"
OUTPUT_DIR="${DATA_ROOT}/bipartite_graphs/mvp/${EXPERIMENT_NAME}"
BASE_SOURCE_DIR="${BASE_SOURCE_DIR:-${DATA_ROOT}/raw/MILPBench/CFL}"
CONFIG="${CONFIG:-${EXEC_DIR}/configs/experiments/mvp_partial_v1.json}"
PARENT_MANIFEST="${PARENT_MANIFEST:-${EXEC_DIR}/configs/splits/cfl_90_seed42_folds.csv}"

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env
python3 -c 'import numpy, pyscipopt, torch, torch_geometric'

PARENT_ARGS=()
while IFS=$'\t' read -r solver run_dir extra; do
    [[ -z "${solver}${run_dir}" ]] && continue
    [[ "$solver" == \#* ]] && continue
    if [[ -n "${extra:-}" || -z "$solver" || -z "$run_dir" ]]; then
        echo "[ERROR] invalid PARENT_RUNS_FILE row; expected: solver<TAB>run_dir" >&2
        exit 2
    fi
    PARENT_ARGS+=(--parent_run "$solver" "$run_dir")
done < "$PARENT_RUNS_FILE"

if [[ ${#PARENT_ARGS[@]} -eq 0 ]]; then
    echo "[ERROR] PARENT_RUNS_FILE contains no parent runs" >&2
    exit 2
fi

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.build_mvp_dataset \
    "${PARENT_ARGS[@]}" \
    --derived_graph_dir "$DERIVED_GRAPH_DIR" \
    --base_source_dir "$BASE_SOURCE_DIR" \
    --output_dir "$OUTPUT_DIR" \
    --config "$CONFIG" \
    --parent_manifest "$PARENT_MANIFEST" \
    "${OVERWRITE_ARGS[@]}"

