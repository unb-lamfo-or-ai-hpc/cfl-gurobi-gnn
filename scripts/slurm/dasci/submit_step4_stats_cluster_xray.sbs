#!/bin/bash
#SBATCH --job-name=pyg_audit_full
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:0        # CPU-only statistics, clustering, and graph inspection
#SBATCH --time=01:00:00    # Allocation for three sequential analysis scripts
#SBATCH --output=slurm_pyg_audit_full_%j.out

echo "=== Starting PyG graph diagnostics on a CPU node ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

# Activate the environment.
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# ---------------------------------------------------------
echo -e "\n--- STEP 1: Descriptive statistics ---"
# ---------------------------------------------------------
srun python3 -m cfl_gnn.cli.graph_statistics

# ---------------------------------------------------------
echo -e "\n--- STEP 2: Dimensionality reduction (PCA/UMAP) ---"
# ---------------------------------------------------------
srun python3 -m cfl_gnn.cli.graph_clustering

# ---------------------------------------------------------
echo -e "\n--- STEP 3: Tensor inspection ---"
# Select the category and data_idx for the graph to inspect.
# ---------------------------------------------------------
srun python3 -m cfl_gnn.cli.graph_xray --category CFL_medium_instance --data_idx 0

echo -e "\n=== Job finished ==="

