#!/bin/bash
#SBATCH --job-name=instance_gnn_smoke
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=02:00:00
#SBATCH --output=slurm_instance_gnn_smoke_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"
EXPERIMENT_NAME="instance_rotation0_smoke_${SLURM_JOB_ID}"

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env

srun python3 -m cfl_gnn.cli.train_instance_serial \
    --manifest configs/splits/cfl_90_seed42_folds.csv \
    --base_pyg_dir "${DATA_ROOT}/bipartite_graphs/instance_baseline_smoke" \
    --output_dir "${DATA_ROOT}/models/instance_baseline/${EXPERIMENT_NAME}" \
    --experiment_name "$EXPERIMENT_NAME" \
    --rotation 0 \
    --label_policy optimal_only \
    --development_only \
    --hidden_dim 32 \
    --num_layers 2 \
    --lr 0.001 \
    --epochs 1 \
    --patience 1 \
    --device cuda
