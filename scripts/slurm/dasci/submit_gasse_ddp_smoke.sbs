#!/bin/bash
#SBATCH --job-name=gasse_ddp
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:2
#SBATCH --time=02:00:00
#SBATCH --output=slurm_gasse_ddp_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] submit from the repository root or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${GUROBI_GRAPH_DATASET_DIR:?Set GUROBI_GRAPH_DATASET_DIR}"
: "${PARENT_COLLECTION_PLAN_DIR:?Set PARENT_COLLECTION_PLAN_DIR}"
: "${PARENT_COLLECTION_RUN_ROOT:?Set PARENT_COLLECTION_RUN_ROOT}"
: "${GASSE_OUTPUT_DIR:?Set GASSE_OUTPUT_DIR}"
: "${LABEL_SOLVER:?Set LABEL_SOLVER to gurobi or scip}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import torch, torch_geometric'

torchrun --standalone --nproc_per_node="${GASSE_DDP_PROCESSES:-2}" \
    -m cfl_gnn.cli.train_gasse_reconnected \
    --graph_dataset_dir "${GUROBI_GRAPH_DATASET_DIR}" \
    --parent_collection_plan_dir "${PARENT_COLLECTION_PLAN_DIR}" \
    --parent_collection_run_root "${PARENT_COLLECTION_RUN_ROOT}" \
    --label_solver "${LABEL_SOLVER}" \
    --output_dir "${GASSE_OUTPUT_DIR}" \
    --mode ddp \
    --epochs "${GASSE_EPOCHS:-1}" \
    --allow_partial_smoke \
    --overwrite
