#!/bin/bash
#SBATCH --job-name=gnn_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --gres=gpu:1       # 1 GPU es perfecto y rapidísimo para inferencia
#SBATCH --time=00:30:00
#SBATCH --output=slurm_evaluation_%j.out

echo "=== Iniciando Evaluación Académica (Neural Diving) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

# --- PANEL DE CONTROL DE EVALUACIÓN ---
# Apuntamos al modelo resultante de nuestro entrenamiento definitivo DDP
MODELO_PATH="/home/vrcelestino/discodatos/cfl-gurobi-gnn/data/models/run_02_partial_dataset/best_model.pt"
EXPERIMENT_NAME="run_02_partial_dataset"
# --------------------------------------

echo "Evaluando modelo: $MODELO_PATH"
echo "Guardando resultados en: data/analysis/$EXPERIMENT_NAME"

# Ejecutamos la v3 en modo serial (limpiará el DDP state_dict automáticamente)
srun python3 src/gnn/evaluate_model_v3.py \
    --model_path $MODELO_PATH \
    --experiment_name $EXPERIMENT_NAME \
    --hidden_dim 64 \
    --batch_size 1 \
    --easy_split 4605 986 988 \
    --medium_split 214 46 47 \
    --hard_split 0 0 0

#    --easy_split 30 0 0 \
#    --medium_split 15 10 5 \
#    --hard_split 0 0 0   

echo "=== Job Finalizado ==="