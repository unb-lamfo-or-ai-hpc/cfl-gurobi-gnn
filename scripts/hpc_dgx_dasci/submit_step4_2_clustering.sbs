#!/bin/bash
#SBATCH --job-name=gnn_cluster
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:0       # PCA y UMAP (1500 muestras) vuelan en CPU
#SBATCH --time=00:30:00    # UMAP tardará apenas unos segundos
#SBATCH --output=slurm_step2_clustering_%j.out

echo "=== Iniciando Paso 2: Reducción de Dimensionalidad (CPU Node) ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

echo "Ejecutando script de PCA y UMAP..."
srun python3 src/data_transformation/graph_clustering_v3.py

echo "=== Job Finalizado ==="