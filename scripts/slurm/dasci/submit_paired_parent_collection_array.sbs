#!/bin/bash
#SBATCH --job-name=cfl_parent_pairs
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=32G
#SBATCH --time=09:00:00
#SBATCH --output=slurm_cfl_parent_pair_%A_%a.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] submit from the repository root or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${PARENT_COLLECTION_PLAN_DIR:?Set PARENT_COLLECTION_PLAN_DIR}"
: "${PARENT_COLLECTION_RUN_ROOT:?Set PARENT_COLLECTION_RUN_ROOT}"
: "${BASE_SOURCE_DIR:?Set BASE_SOURCE_DIR to data/raw/MILPBench/CFL}"
: "${SLURM_ARRAY_TASK_ID:?Submit this script with --array}"

GUROBI_LICENSE_FILE="${GUROBI_LICENSE_FILE:-${EXEC_DIR}/secrets/gurobi.lic}"
if [[ ! -s "${GUROBI_LICENSE_FILE}" ]]; then
    echo "[ERROR] Gurobi license is missing; set GUROBI_LICENSE_FILE" >&2
    exit 2
fi
export GRB_LICENSE_FILE="${GUROBI_LICENSE_FILE}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import gurobipy, pyarrow, pyscipopt'

ARGS=(--resume)
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    ARGS+=(--overwrite)
fi

echo "[INFO] parent_task=${SLURM_ARRAY_TASK_ID} | order=gurobi,scip"

for SOLVER_NAME in gurobi scip; do
    echo "[INFO] starting solver=${SOLVER_NAME}"
    srun python3 -m cfl_gnn.cli.run_parent_collection_task \
        --plan_dir "${PARENT_COLLECTION_PLAN_DIR}" \
        --solver "${SOLVER_NAME}" \
        --task_index "${SLURM_ARRAY_TASK_ID}" \
        --base_source_dir "${BASE_SOURCE_DIR}" \
        --run_root "${PARENT_COLLECTION_RUN_ROOT}" \
        --experiment_config \
        "${EXEC_DIR}/configs/experiments/mvp_partial_v1.json" \
        "${ARGS[@]}"
done
