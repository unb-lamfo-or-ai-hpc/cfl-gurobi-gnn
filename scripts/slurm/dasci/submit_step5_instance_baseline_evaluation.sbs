#!/bin/bash
#SBATCH --job-name=instance_gnn_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=01:00:00
#SBATCH --output=slurm_instance_gnn_eval_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"
: "${EXPERIMENT_NAME:?Submit with --export=ALL,EXPERIMENT_NAME=<training-run>}"
RUN_DIR="${DATA_ROOT}/models/instance_baseline/${EXPERIMENT_NAME}"

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env

srun python3 -m cfl_gnn.cli.evaluate_instance \
    --checkpoint "${RUN_DIR}/best_model.pt" \
    --training_plan "${RUN_DIR}/instance_training_plan.json" \
    --experiment_summary "${RUN_DIR}/experiment_summary.json" \
    --manifest configs/splits/cfl_90_seed42_folds.csv \
    --base_pyg_dir "${DATA_ROOT}/bipartite_graphs/instance_baseline_smoke" \
    --output_dir "${RUN_DIR}/evaluation_fixed_threshold" \
    --device cuda
