#!/bin/bash
#SBATCH --job-name=mvp_nd_review
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:15:00
#SBATCH --output=slurm_mvp_neural_diving_comparison_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from it or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${BENCHMARK_DIR:?Set BENCHMARK_DIR}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"

ARGS=(
    --benchmark_dir "${BENCHMARK_DIR}"
    --output_dir "${OUTPUT_DIR}"
)
if [[ -n "${CONFIG_PATH:-}" ]]; then
    ARGS+=(--config "${CONFIG_PATH}")
fi
if [[ "${DRY_RUN:-0}" == "1" ]]; then
    ARGS+=(--dry_run)
fi
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    ARGS+=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.review_mvp_neural_diving "${ARGS[@]}"
