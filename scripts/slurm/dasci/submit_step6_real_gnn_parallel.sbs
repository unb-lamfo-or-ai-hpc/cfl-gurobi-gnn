#!/bin/bash
#SBATCH --job-name=real_gnn
#SBATCH --nodes=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=64G
#SBATCH --gres=gpu:4
#SBATCH --time=08:00:00
#SBATCH --output=slurm_real_gnn_%j.out

echo "=== Legacy GNN training with a real dataset (DDP) ==="
EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env 

MODULE_NAME="cfl_gnn.cli.train_distributed"

# DDP launcher: configure processes for the allocated single node.
# Match --nproc_per_node to the number of allocated GPUs.

# Option A: Small diagnostic configuration
# Launch DDP directly with torchrun, without an additional srun.
# Ensure --nproc_per_node matches --gres=gpu:X.
#torchrun --nproc_per_node=4 -m $MODULE_NAME \
#    --experiment_name run_01_ddp \
#    --easy_split 30 0 0 \
#    --medium_split 15 10 5 \
#    --hard_split 0 0 0 \
#    --hidden_dim 64 \
#    --lr 0.00005 \
#    --grad_clip 1.0 \
#    --epochs 100 \
#    --patience 15

# Option B: Full easy and partial medium legacy graph inventory
# Launch torchrun on the four allocated GPUs.
torchrun --nproc_per_node=4 -m $MODULE_NAME \
    --experiment_name run_02_partial_dataset_ddp \
    --easy_split 4605 986 988 \
    --medium_split 214 46 47 \
    --hard_split 0 0 0 \
    --hidden_dim 64 \
    --lr 0.00005 \
    --grad_clip 1.0 \
    --epochs 150 \
    --patience 20

echo "=== Job finished ==="

