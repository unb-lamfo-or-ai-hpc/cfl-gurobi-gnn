#!/bin/bash
#SBATCH --job-name=mvp_nd_task
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --time=04:30:00
#SBATCH --output=slurm_mvp_neural_diving_%A_%a.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from it or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${PLAN_PATH:?Set PLAN_PATH}"
: "${EVALUATION_DIR:?Set EVALUATION_DIR}"
: "${BASE_SOURCE_DIR:?Set BASE_SOURCE_DIR}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"
: "${SLURM_ARRAY_TASK_ID:?Submit this script with --array}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"

OVERWRITE_ARGS=()
if [[ "${OVERWRITE:-0}" == "1" ]]; then
    OVERWRITE_ARGS=(--overwrite)
fi

srun python3 -m cfl_gnn.cli.benchmark_mvp_neural_diving run-task \
    --plan "${PLAN_PATH}" \
    --evaluation_dir "${EVALUATION_DIR}" \
    --base_source_dir "${BASE_SOURCE_DIR}" \
    --output_dir "${OUTPUT_DIR}" \
    --task_index "${SLURM_ARRAY_TASK_ID}" \
    "${OVERWRITE_ARGS[@]}"
