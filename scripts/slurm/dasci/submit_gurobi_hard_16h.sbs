#!/bin/bash
#SBATCH --job-name=cfl_hard16h
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=slurm_cfl_hard16h_%j.out

set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:?Submit from the repository root}}"
exec bash "${EXEC_DIR}/scripts/slurm/dasci/run_gurobi_expansion_campaign.sh" hard 0
