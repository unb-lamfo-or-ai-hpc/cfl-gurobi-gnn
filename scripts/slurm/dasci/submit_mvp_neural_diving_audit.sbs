#!/bin/bash
#SBATCH --job-name=mvp_nd_audit
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:10:00
#SBATCH --output=slurm_mvp_neural_diving_audit_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable; submit from it or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${PLAN_PATH:?Set PLAN_PATH}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"

srun python3 -m cfl_gnn.cli.benchmark_mvp_neural_diving audit \
    --plan "${PLAN_PATH}" \
    --output_dir "${OUTPUT_DIR}"
