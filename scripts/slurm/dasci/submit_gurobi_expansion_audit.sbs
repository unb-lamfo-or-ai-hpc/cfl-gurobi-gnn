#!/bin/bash
#SBATCH --job-name=cfl_90_audit
#SBATCH --partition=batch
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=4G
#SBATCH --time=00:30:00
#SBATCH --output=slurm_cfl_90_audit_%j.out

set -euo pipefail
EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] repository root is unavailable" >&2
    exit 2
fi
: "${DATA_ROOT:?Set DATA_ROOT}"
: "${EXPANSION_PLAN_DIR:?Set EXPANSION_PLAN_DIR}"
: "${EXPANSION_RUN_ROOT:?Set EXPANSION_RUN_ROOT}"
: "${EXPANSION_AUDIT_DIR:?Set EXPANSION_AUDIT_DIR}"
cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV:-tfm_env}"
srun python3 -m cfl_gnn.cli.gurobi_expansion audit \
    --data_root "${DATA_ROOT}" \
    --campaign_dir "${EXPANSION_PLAN_DIR}" \
    --run_root "${EXPANSION_RUN_ROOT}" \
    --output_dir "${EXPANSION_AUDIT_DIR}"
