#!/bin/bash
#SBATCH --job-name=gasse_eval
#SBATCH --nodes=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --gres=gpu:1
#SBATCH --time=02:00:00
#SBATCH --output=slurm_gasse_eval_%j.out

set -euo pipefail

EXEC_DIR="${EXEC_DIR:-${SLURM_SUBMIT_DIR:-}}"
if [[ -z "${EXEC_DIR}" || ! -f "${EXEC_DIR}/pyproject.toml" ]]; then
    echo "[ERROR] submit from the repository root or set EXEC_DIR" >&2
    exit 2
fi
EXEC_DIR=$(cd "${EXEC_DIR}" && pwd)
CONDA_ENV="${CONDA_ENV:-tfm_env}"

: "${GASSE_TRAINING_DIR:?Set GASSE_TRAINING_DIR}"
: "${GUROBI_GRAPH_DATASET_DIR:?Set GUROBI_GRAPH_DATASET_DIR}"
: "${PARENT_COLLECTION_RUN_ROOT:?Set PARENT_COLLECTION_RUN_ROOT}"
: "${GASSE_EVALUATION_DIR:?Set GASSE_EVALUATION_DIR}"

cd "${EXEC_DIR}"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"
eval "$(conda shell.bash hook)"
conda activate "${CONDA_ENV}"
python3 -c 'import torch, torch_geometric'

srun python3 -m cfl_gnn.cli.evaluate_gasse_reconnected \
    --training_plan "${GASSE_TRAINING_DIR}/gasse_training_plan.json" \
    --training_report "${GASSE_TRAINING_DIR}/gasse_training_report.json" \
    --checkpoint "${GASSE_TRAINING_DIR}/best_model.pt" \
    --graph_dataset_dir "${GUROBI_GRAPH_DATASET_DIR}" \
    --parent_collection_run_root "${PARENT_COLLECTION_RUN_ROOT}" \
    --output_dir "${GASSE_EVALUATION_DIR}" \
    --device cuda \
    --overwrite
