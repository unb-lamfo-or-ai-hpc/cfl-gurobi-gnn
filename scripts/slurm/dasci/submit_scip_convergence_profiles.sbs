#!/bin/bash
#SBATCH --job-name=scip_profiles
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=03:30:00
#SBATCH --output=slurm_scip_convergence_profiles_%j.out

set -euo pipefail

EXEC_DIR="/home/vrcelestino/discodatos/cfl-gurobi-gnn"
DATA_ROOT="/raid/vrcelestino/data/cfl-gurobi-gnn/data"
SOURCE_RUN_DIR="${SOURCE_RUN_DIR:-}"
GRAPH_AUDIT_REPORT="${GRAPH_AUDIT_REPORT:-}"
BASELINE_RUN_DIR="${BASELINE_RUN_DIR:-}"
PARENT_INSTANCE_ID="${PARENT_INSTANCE_ID:-CFL_easy_instance_0}"
HARDWARE_CLASS="${HARDWARE_CLASS:-dasci_dgx}"
EXPERIMENT_STAGE="${EXPERIMENT_STAGE:-engineering_smoke}"
EXPERIMENT_NAME="${EXPERIMENT_NAME:-scip_convergence_profiles_${SLURM_JOB_ID}}"
OUTPUT_DIR="${DATA_ROOT}/analysis/scip_convergence_profiles/${EXPERIMENT_NAME}"
TIME_LIMIT="${TIME_LIMIT:-300}"
NODE_LIMIT="${NODE_LIMIT:-1000000}"
MAX_PARALLEL="${MAX_PARALLEL:-4}"
SEED="${SEED:-42}"

if [[ -z "$SOURCE_RUN_DIR" || ! -d "$SOURCE_RUN_DIR/candidates" ]]; then
    echo "Set SOURCE_RUN_DIR to the completed schema-v3 PySCIPOpt probe" >&2
    exit 2
fi
if [[ -z "$GRAPH_AUDIT_REPORT" || ! -s "$GRAPH_AUDIT_REPORT" ]]; then
    echo "Set GRAPH_AUDIT_REPORT to the passed PR #20 report" >&2
    exit 2
fi
if [[ -z "$BASELINE_RUN_DIR" ]]; then
    echo "Set BASELINE_RUN_DIR to the completed schema-v3 PR #21 run" >&2
    exit 2
fi

ROOT_MIP="${SOURCE_RUN_DIR}/candidates/root_mip_baseline.lp"
BASELINE_PLAN="${BASELINE_RUN_DIR}/scip_derived_label_audit_plan.json"
BASELINE_REPORT="${BASELINE_RUN_DIR}/scip_derived_label_validation_report.json"
for required in "$ROOT_MIP" "$BASELINE_PLAN" "$BASELINE_REPORT"; do
    if [[ ! -s "$required" ]]; then
        echo "Missing required artifact: $required" >&2
        exit 2
    fi
done

mapfile -t NODE_MIPS < <(
    find "${SOURCE_RUN_DIR}/candidates" \
        -maxdepth 1 -type f -name 'node_*_mip.lp' -print | sort
)
if [[ "${#NODE_MIPS[@]}" -eq 0 ]]; then
    echo "No node writeMIP candidates found in $SOURCE_RUN_DIR" >&2
    exit 2
fi

cd "$EXEC_DIR"
export PYTHONPATH="${EXEC_DIR}/src:${PYTHONPATH:-}"

eval "$(conda shell.bash hook)"
conda activate tfm_env
python3 -c 'import pyscipopt'

srun python3 -m cfl_gnn.cli.audit_scip_convergence_profiles \
    --parent_instance_id "$PARENT_INSTANCE_ID" \
    --root_mip "$ROOT_MIP" \
    --node_mips "${NODE_MIPS[@]}" \
    --graph_audit_report "$GRAPH_AUDIT_REPORT" \
    --baseline_plan "$BASELINE_PLAN" \
    --baseline_report "$BASELINE_REPORT" \
    --output_dir "$OUTPUT_DIR" \
    --experiment_stage "$EXPERIMENT_STAGE" \
    --hardware_class "$HARDWARE_CLASS" \
    --time_limit "$TIME_LIMIT" \
    --node_limit "$NODE_LIMIT" \
    --max_parallel "$MAX_PARALLEL" \
    --seed "$SEED"
