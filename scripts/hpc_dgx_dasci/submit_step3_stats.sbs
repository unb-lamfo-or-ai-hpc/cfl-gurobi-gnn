#!/bin/bash
#SBATCH --job-name=gnn_stats
#SBATCH --nodes=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:0       # No necesitamos GPU para estadística básica
#SBATCH --time=00:30:00    # Tiempo de sobra para leer 1500 archivos
#SBATCH --output=slurm_step1_stats_%j.out

echo "=== Iniciando Paso 1: Extracción de Estadísticas (CPU Node) ==="
EXEC_DIR="/raid/vrcelestino/data/cfl-gurobi-gnn"
cd $EXEC_DIR

# Activar entorno
eval "$(conda shell.bash hook)"
conda activate tfm_env 

echo "Ejecutando script de estadística descriptiva..."
srun python3 src/data_transformation/dataset_statistics_v2.py

echo "=== Job Finalizado ==="